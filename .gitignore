# 忽略操作系统相关的文件
.DS_Store
Thumbs.db
.cache/

# 忽略日志文件
*.log
drsai_test.env
model_status.yaml

# 忽略临时文件
tmp/
tmp_test/

# 忽略 Python 编译文件
*.pyc
*.pyo
__pycache__/

# Gatsby build:sync 写入 drsai_ui 的部署静态资源；由前端源码构建生成
/src/drsai_ui/ui_backend/backend/web/ui/

# 忽略 IDE 的配置文件
.vscode/
.idea/

# 忽略测试文件
test/

.webui_secret_key

# 忽略files文件夹
files/*

# 忽略智能体工作目录
agentWorkSpace/
userRecord/
datasets/

test_datesets/*
# datasets/*
*.gpx
*.lst
*.csv

# 忽略 pyZRietveld 的预编译二进制（单文件 100MB+，超出 GitHub 限制；
# 需要分发时请挂 GitHub Release，不要再提交进仓库）
