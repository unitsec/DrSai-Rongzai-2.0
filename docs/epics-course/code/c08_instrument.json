{
  "instrument": "教学实验站（虚拟恒温箱 + 假衍射仪 + 开发板）",
  "prefix": "LAB:",
  "safety": {
    "dry_run": false,
    "max_write_rate_hz": 5,
    "max_actions_per_run": 2000,
    "audit_log": "logs/audit.jsonl"
  },
  "safe_state": {
    "heater": 0,
    "setpoint": 25,
    "run_permit": 0,
    "shutter": 0,
    "servo": 0,
    "led": 0
  },
  "channels": {
    "temperature": {
      "pv": "LAB:TempRaw",
      "units": "degC",
      "role": "measurement",
      "writable": false,
      "limits": [
        0,
        120
      ],
      "desc": "样品温度（由温控仪/虚拟恒温箱提供）"
    },
    "over_temp": {
      "pv": "LAB:OverTemp",
      "units": "flag",
      "role": "interlock",
      "writable": false,
      "limits": [
        0,
        1
      ],
      "desc": "超温标志，1 = 已经超过 80 度；任何加热动作都必须先看它"
    },
    "heater_enable": {
      "pv": "LAB:HeaterEnable",
      "units": "flag",
      "role": "interlock",
      "writable": false,
      "limits": [
        0,
        1
      ],
      "desc": "加热允许标志，1 = 允许加热（需要 run_permit=1 且未超温）"
    },
    "setpoint": {
      "pv": "LAB:SetPointTemp",
      "units": "degC",
      "role": "setpoint",
      "writable": true,
      "limits": [
        0,
        90
      ],
      "max_step": 20,
      "desc": "目标温度。每次调整幅度不允许超过 20 度（保护样品和加热器）"
    },
    "heater": {
      "pv": "LAB:Power",
      "units": "percent",
      "role": "actuator",
      "writable": true,
      "limits": [
        0,
        100
      ],
      "max_step": 50,
      "requires": {
        "heater_enable": 1
      },
      "desc": "加热功率。要求 heater_enable=1，否则拒绝写入"
    },
    "run_permit": {
      "pv": "LAB:RunPermit",
      "units": "bool",
      "role": "permit",
      "writable": true,
      "allowed": [
        0,
        1
      ],
      "desc": "运行许可。1 = 允许加热，0 = 禁止"
    },
    "theta": {
      "pv": "LAB:Theta",
      "units": "deg",
      "role": "axis",
      "writable": true,
      "limits": [
        0,
        90
      ],
      "max_step": 45,
      "desc": "样品台角度设定值"
    },
    "theta_rb": {
      "pv": "LAB:ThetaRB",
      "units": "deg",
      "role": "readback",
      "writable": false,
      "limits": [
        0,
        90
      ],
      "settle": {
        "tol": 0.05,
        "timeout": 20
      },
      "desc": "角度实际回读值。写 theta 之后必须等它到位"
    },
    "counts": {
      "pv": "LAB:Counts",
      "units": "counts/s",
      "role": "detector",
      "writable": false,
      "limits": [
        0,
        100000
      ],
      "desc": "探测器计数率"
    },
    "shutter": {
      "pv": "LAB:Shutter",
      "units": "bool",
      "role": "actuator",
      "writable": true,
      "allowed": [
        0,
        1
      ],
      "desc": "快门：1 = 打开（出束），0 = 关闭"
    },
    "servo": {
      "pv": "LAB:Servo",
      "units": "deg",
      "role": "actuator",
      "writable": true,
      "limits": [
        0,
        180
      ],
      "max_step": 90,
      "desc": "开发板上的舵机（第 7 章硬件）（第 7 章开发板上的可选硬件，不在线不影响主流程）",
      "optional": true
    },
    "led": {
      "pv": "LAB:LED",
      "units": "bool",
      "role": "actuator",
      "writable": true,
      "allowed": [
        0,
        1
      ],
      "desc": "开发板上的 LED（第 7 章硬件）（第 7 章开发板上的可选硬件，不在线不影响主流程）",
      "optional": true
    }
  }
}
