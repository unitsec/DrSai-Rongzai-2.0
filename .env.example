# Rongzai Agent configuration
# Copy this file to .env, then replace every /path/to/rongzai-agent value with
# the absolute path of this checkout. Never commit .env or any credential value.

# -----------------------------------------------------------------------------
# Core paths and runtime mode
# -----------------------------------------------------------------------------
# Selects development behavior (DEV) or production behavior with SSO required (PROD).
SERVICE_MODE=DEV
# Absolute directory where agent tasks and generated artifacts are stored.
WORKDIR=/path/to/rongzai-agent/agentWorkSpace
# Optional worker data directory. Leave empty to use the worker default behavior.
WORKER_SPACE=
# Absolute directory containing the system skills made available to the agent.
SYSTEM_SKILLS_DIR=/path/to/rongzai-agent/agent_skills
# Absolute directory used to persist files uploaded through the UI.
DRSAI_UI_USER_FILES_ROOT=/path/to/rongzai-agent/tmp/drsai_ui/files/user
# Public path prefix before the DrSai API, for example /drsai in a mounted deployment.
DRSAI_UI_PUBLIC_PREFIX=/drsai

# -----------------------------------------------------------------------------
# UI and frontend
# -----------------------------------------------------------------------------
# Use "internal" for src/drsai_ui in this repository, or "external" for an installed package.
DRSAI_UI_MODE=internal
# Source root that contains the internal drsai_ui package when DRSAI_UI_MODE=internal.
DRSAI_UI_INTERNAL_SRC=/path/to/rongzai-agent/src
# TCP port for the Python UI service.
RONGZAI_UI_PORT=8081
# Public UI backend URL used while building the Gatsby frontend; leave empty for its localhost default.
GATSBY_API_URL=
# TCP port used by `yarn develop`; empty uses the package.json default.
GATSBY_DEV_PORT=
# Optional frontend sync destination when using an external drsai_ui installation.
DRSAI_UI_STATIC_DIR=
# Optional internal frontend static destination; empty uses the repository default.
DRSAI_UI_INTERNAL_STATIC_DIR=

# -----------------------------------------------------------------------------
# Agent worker and remote-agent catalogue
# -----------------------------------------------------------------------------
# TCP port for run_agent_web.py. Keep it distinct from every MCP tool port.
RZ_PORT_AGENT_WEB=42501
# Absolute path to the JSON catalogue shown by the UI.
DEFAULT_REMOTE_AGENTS=/path/to/rongzai-agent/remote_agents_web.json
# Automatically load the configured default remote agent in the UI.
DRSUI_AUTO_LOAD_DEFAULT_AGENT=true
# Display name of the remote agent automatically selected by the UI.
DRSUI_DEFAULT_AGENT_NAME=Rongzai Agent Dev
# Skip loading the DDF agent catalogue when only remote agents should be offered.
DRSUI_DISABLE_DDF_AGENTS=true
# Optional JSON file defining sub-agent workers; empty uses subagent_remote_workers.json when present.
RONGZAI_SUBAGENT_CONFIG_FILE=
# Comma-separated account IDs granted VIP behavior; empty disables the list.
VIP_USER_LIST=
# Comma-separated account IDs blocked from the configured free-model path; empty blocks nobody.
BLACK_LIST=

# -----------------------------------------------------------------------------
# Credentials and external integrations
# -----------------------------------------------------------------------------
# API key for HepAI model and file services. Required for model calls that use HepAI.
HEPAI_API_KEY=
# Optional administrator API key for HepAI application-management integrations.
HEPAI_APP_ADMIN_API_KEY=
# Optional Materials Project API key used by tools/material_project/structure_api.py.
MP_API_KEY=
# Optional RAGFlow service base URL.
RAGFLOW_URL=
# Optional RAGFlow bearer token.
RAGFLOW_TOKEN=
# Optional RAGFlow dataset ID for manually managed knowledge.
MANUAL_DATASET_ID=
# Optional RAGFlow dataset ID for agent memory.
MEMORY_DATASET_ID=
# Worker host/IP supplied to integrations that need to call this deployment.
WORKER_IP=
# DOMAS service base URI used by deployment integrations.
DOMAS_URI=
# Comma-separated administrator user IDs used by platform integrations.
PLATFORM_ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Remote desktop and file handling
# -----------------------------------------------------------------------------
# Base URL of the VNC API service. Required only when VNC features are enabled.
VNC_SERVICE_URL=
# First allocatable VNC TCP port, inclusive.
MIN_PORT=40000
# Last allocatable VNC TCP port, inclusive.
MAX_PORT=65000
# Set true to upload frontend files to HepAI-backed file storage; false keeps local handling.
USE_HEPAI_FILE=false

# -----------------------------------------------------------------------------
# Model selection, retry, and agent behavior
# -----------------------------------------------------------------------------
# Model configuration name reserved for automatic history summarization.
RONGZAI_SUMMARY_MODEL_CONFIG=deepseek-v4-flash (free)
# JSON array of model IDs tried after the primary model fails.
RONGZAI_LLM_FALLBACK_CONFIGS=["openai/gpt-5","deepseek-ai/deepseek-v4-pro","minimax/minimax-m2.7"]
# Retries for the initial streaming request before switching to a fallback model.
RONGZAI_STREAM_RETRY_ATTEMPTS=1
# Maximum retries attempted by the fallback-model path.
RONGZAI_FALLBACK_MAX_RETRIES=0
# Timeout in seconds for a fallback-model request.
RONGZAI_FALLBACK_TIMEOUT=60
# Set true to skip the model follow-up response when a tool call completes without a result.
RONGZAI_SKIP_NO_TOOL_FOLLOWUP=false
# Test-only switch that forces invalid model output.
RONGZAI_FORCE_INVALID_MODEL_OUTPUT=false
# Set 1 to log the assembled system prompt.
RONGZAI_DEBUG_SYSTEM_PROMPT=0
# Set 1 to log full model output; disable in production if logs may contain sensitive content.
RONGZAI_DEBUG_LLM_OUTPUT=1
# Optional sampling temperature in the inclusive range 0-2; empty uses the service default.
RONGZAI_LLM_TEMPERATURE=
# Optional integer model seed; empty leaves sampling nondeterministic.
RONGZAI_LLM_SEED=
# Enable DeepSeek thinking mode. Temperature is applied only when this is false.
RONGZAI_DEEPSEEK_THINKING=true
# Number of context tokens that triggers automatic history compression.
RONGZAI_CONTEXT_COMPRESS_THRESHOLD_TOKENS=50000
# Set 1 to disable built-in core skill tools.
RONGZAI_DISABLE_CORE_SKILL_TOOLS=0
# Set 1 to disable the memo-writing tool.
RONGZAI_DISABLE_MEMO_WRITE_TOOL=0
# Set false to prevent images generated by remote sub-agents from appearing automatically in the UI.
RONGZAI_SHOW_SUBAGENT_IMAGES=true

# -----------------------------------------------------------------------------
# Authentication and session security
# -----------------------------------------------------------------------------
# IHEP OAuth application key. Required when SERVICE_MODE=PROD.
IHEP_SSO_APP_KEY=
# IHEP OAuth application secret. Required when SERVICE_MODE=PROD.
IHEP_SSO_APP_SECRET=
# Public OAuth callback URL ending in /umt/callback. Required when SERVICE_MODE=PROD.
IHEP_SSO_REDIRECT_URI=
# Stable random secret used to sign UI sessions. Set a unique production value.
SECRET_KEY=
# Optional CAS endpoint for resolving a science-user token ID.
SCIENCE_USER_TOKEN_API=http://s01.lssf.cas.cn:8000/dzz-api/restApi_/api/queryAuthAccessTokenById
# Optional IHEP endpoint for validating a science-user access token.
SCIENCE_USER_VERIFY_API=https://newlogin.ihep.ac.cn/api/validateAccessToken

# -----------------------------------------------------------------------------
# Service ports
# -----------------------------------------------------------------------------
# SSE port for the GSAS-II neutron-refinement MCP tool.
MCP_GSASII_REFINE_PORT=42506
# SSE port for the PDF-refinement MCP tool.
MCP_PDF_REFINE_PORT=42507
# SSE port for the SasView fitting MCP tool.
MCP_SASVIEW_REFINE_PORT=42508
# SSE port for the Irena size-distribution MCP tool.
MCP_IRENA_REFINE_PORT=42509
# SSE port for the Z-Rietveld MCP tool.
MCP_ZRIETVELD_REFINE_PORT=42510
# SSE port for offline magnetic-structure analysis and candidate refinement.
MCP_MAGNETIC_STRUCTURE_PORT=42512
# BLAS/OpenMP threads per magnetic analysis subprocess (1-32).
RONGZAI_MAGNETIC_THREADS=1
