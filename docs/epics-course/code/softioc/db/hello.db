# =============================================================================
# hello.db —— 你的第一个 EPICS 数据库（第 3 章）
# 用法：  softIoc -d db/hello.db -m P=LAB:
# 读：    caget LAB:Sine        （或者 pvget LAB:Sine）
# 写：    caput LAB:SetPoint 3.3
# 订阅：  camonitor LAB:Sine
# =============================================================================

# 一个"自己会动"的计数器：每秒把自己加一。
# 技巧：calc 记录把 INPA 指向自己，读到的是上一次的 VAL。
record(calc, "$(P)Counter") {
    field(DESC, "每秒 +1 的计数器")
    field(SCAN, "1 second")      # 每秒处理一次
    field(INPA, "$(P)Counter")   # 输入链接：自己的当前值
    field(CALC, "A+1")           # 计算表达式（EPICS 内置的 calc 语言）
}

# 一个自动变化的模拟量，用来冒充"传感器"。
record(calc, "$(P)Sine") {
    field(DESC, "自动变化的正弦波")
    field(SCAN, "1 second")
    field(INPA, "$(P)Counter")
    field(CALC, "5*SIN(A/5)")
    field(EGU,  "V")             # 工程单位：永远要写
    field(PREC, "3")             # 显示 3 位小数
    field(HOPR, "10")            # 操作界面的显示上限
    field(LOPR, "-10")           # 操作界面的显示下限
}

# 一个你能写的设定值。DRVL/DRVH 是"驱动限值"。
record(ao, "$(P)SetPoint") {
    field(DESC, "手动设定值")
    field(DTYP, "Soft Channel")
    field(EGU,  "V")
    field(DRVL, "-10")
    field(DRVH, "10")
    field(PREC, "3")
    field(IVOA, "Set output to IVOV")   # 输入无效时怎么办
    field(IVOV, "0")                    # 无效时的安全输出（这里是 0 V）
}
