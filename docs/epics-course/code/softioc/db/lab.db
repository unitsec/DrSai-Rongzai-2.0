# =============================================================================
# lab.db —— 虚拟实验站：覆盖第 4 章要讲的所有常用记录类型（第 4 章）
# 用法：  softIoc -d db/lab.db -m P=LAB:
#
# 这个文件刻意写成"一个真实实验站该有的样子"：
#   信号自己有单位、有量程、有限值、有报警、有联动、有安全默认值。
# 你把它读懂，散裂上 80% 的 PV 你都能猜出是什么意思。
#
# ⚠️ 两个已经踩过的坑（第 4 章会展开讲）：
#   1. DESC 字段只有 41 字节，中文一个字 3 字节，写长了 IOC 直接拒绝加载；
#   2. 菜单型字段（OMSL/IVOA/SCAN...）的字符串跟 EPICS 版本有关，
#      7.0.10 里 OMSL 是 "supervisory" / "closed_loop"（小写）。
#      版本不同写法可能不同 —— 永远以本机 dbd 文件或在线文档为准。
# =============================================================================

# -----------------------------------------------------------------------------
# 1) 会自己动的信号：计数器 / 100ms 快信号 / 正弦
# -----------------------------------------------------------------------------
record(calc, "$(P)Counter") {
    field(DESC, "每秒 +1 的计数器")
    field(SCAN, "1 second")
    field(INPA, "$(P)Counter")
    field(CALC, "A+1")
}

record(calc, "$(P)Counter100ms") {
    field(DESC, "每 100ms +1 的快计数器")
    field(SCAN, ".1 second")
    field(INPA, "$(P)Counter100ms")
    field(CALC, "A+1")
}

record(calc, "$(P)Wave") {
    field(DESC, "缓慢变化的模拟电压")
    field(SCAN, "1 second")
    field(INPA, "$(P)Counter")
    field(CALC, "5*SIN(A/5)")
    field(EGU,  "V")
    field(PREC, "3")
    field(HOPR, "10")
    field(LOPR, "-10")
    field(ADEL, "0.05")
}

# -----------------------------------------------------------------------------
# 2) 测量链：原始值 -> 单位换算 -> 报警 -> 联锁
#    TempRaw 用 Passive：只在被写（真设备上是 I/O Intr 中断）时才更新
# -----------------------------------------------------------------------------
record(ai, "$(P)TempRaw") {
    field(DESC, "温控仪返回的温度")
    field(DTYP, "Soft Channel")
    field(EGU,  "degC")
    field(SCAN, "Passive")
    field(PREC, "2")
    field(HOPR, "200")
    field(LOPR, "-50")
    field(HIGH, "80")
    field(HIHI, "95")
    field(HSV,  "MINOR")
    field(HHSV, "MAJOR")
    field(ADEL, "0.05")
    field(FLNK, "$(P)TempK")
}

record(calc, "$(P)TempK") {
    field(DESC, "摄氏转开尔文")
    field(INPA, "$(P)TempRaw")
    field(CALC, "A+273.15")
    field(EGU,  "K")
    field(PREC, "2")
    field(FLNK, "$(P)OverTemp")
}

record(calc, "$(P)OverTemp") {
    field(DESC, "超温标志 1=超过80度")
    field(INPA, "$(P)TempRaw")
    field(CALC, "A>80")
    field(EGU,  "flag")
    field(PREC, "0")
    field(FLNK, "$(P)HeaterEnable")   # 超温状态一变，立刻重算联锁
}

# -----------------------------------------------------------------------------
# 3) 设定值 + 驱动限值
# -----------------------------------------------------------------------------
record(ao, "$(P)SetPointTemp") {
    field(DESC, "目标温度")
    field(DTYP, "Soft Channel")
    field(VAL,  "25")          # 安全初值：冷启动时是室温，不是 0 度也不是满功率
    field(EGU,  "degC")
    field(DRVL, "0")
    field(DRVH, "150")
    field(PREC, "1")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "25")
}

record(ai, "$(P)SetPointTempRB") {
    field(DESC, "目标温度回读")
    field(DTYP, "Soft Channel")
    field(INP,  "$(P)SetPointTemp")
    field(SCAN, "1 second")
    field(EGU,  "degC")
    field(PREC, "1")
}

# 客户端直接控制的加热功率（第 6 章 Python PID 写这个）
record(ao, "$(P)Power") {
    field(DESC, "加热功率-客户端控制")
    field(DTYP, "Soft Channel")
    field(EGU,  "%")
    field(DRVL, "0")
    field(DRVH, "100")
    field(PREC, "1")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "0")
}

record(ai, "$(P)PowerRB") {
    field(DESC, "加热功率回读")
    field(DTYP, "Soft Channel")
    field(INP,  "$(P)Power")
    field(SCAN, "1 second")
    field(EGU,  "%")
    field(PREC, "1")
}

# -----------------------------------------------------------------------------
# 4) 开关量与联锁
# -----------------------------------------------------------------------------
record(bo, "$(P)Shutter") {
    field(DESC, "快门 0=关 1=开")
    field(DTYP, "Soft Channel")
    field(ZNAM, "Closed")
    field(ONAM, "Open")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "0")
}

record(bi, "$(P)ShutterRB") {
    field(DESC, "快门状态回读")
    field(DTYP, "Soft Channel")
    field(INP,  "$(P)Shutter")
    field(SCAN, "1 second")
    field(ZNAM, "Closed")
    field(ONAM, "Open")
}

record(bo, "$(P)RunPermit") {
    field(DESC, "运行许可 1=允许加热")
    field(DTYP, "Soft Channel")
    field(ZNAM, "NotPermitted")
    field(ONAM, "Permitted")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "0")
}

record(calc, "$(P)HeaterEnable") {
    field(DESC, "加热允许标志")
    field(SCAN, ".2 second")     # 联锁自己也要周期性重算，别只靠别人推
    field(INPA, "$(P)RunPermit")
    field(INPB, "$(P)OverTemp")
    field(CALC, "A&&!B")
    field(EGU,  "flag")
    field(PREC, "0")
}

# 把 P 控制器和联锁都放进数据库（第 4 章演示，第 6 章用 Python 做完整 PID）
record(calc, "$(P)HeatCalc") {
    field(DESC, "P控制+联锁输出")
    field(SCAN, ".1 second")
    field(INPA, "$(P)HeaterEnable")
    field(INPB, "$(P)SetPointTemp")
    field(INPC, "$(P)TempRaw")
    field(CALC, "A ? MAX(0,MIN(100,5*(B-C))) : 0")
    field(EGU,  "%")
    field(PREC, "1")
}

# Closed Loop 输出：它的值由 DOL 决定，客户端写它会被立刻覆盖
record(ao, "$(P)Heater") {
    field(DESC, "加热功率-数据库闭环")
    field(DTYP, "Soft Channel")
    field(EGU,  "%")
    field(DRVL, "0")
    field(DRVH, "100")
    field(PREC, "1")
    field(SCAN, ".1 second")
    field(OMSL, "closed_loop")
    field(DOL,  "$(P)HeatCalc")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "0")
}

record(ai, "$(P)HeaterRB") {
    field(DESC, "闭环加热功率回读")
    field(DTYP, "Soft Channel")
    field(INP,  "$(P)Heater")
    field(SCAN, "1 second")
    field(EGU,  "%")
    field(PREC, "1")
}

# -----------------------------------------------------------------------------
# 5) 枚举状态机：mbbo（命令）+ mbbi（状态）
# -----------------------------------------------------------------------------
record(mbbo, "$(P)StateSel") {
    field(DESC, "选择实验阶段")
    field(DTYP, "Soft Channel")
    field(ZRST, "Idle")
    field(ONST, "Heating")
    field(TWST, "Soaking")
    field(THST, "Done")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "0")
}

record(mbbi, "$(P)State") {
    field(DESC, "实际实验阶段")
    field(DTYP, "Soft Channel")
    field(INP,  "$(P)StateSel")
    field(SCAN, "1 second")
    field(ZRST, "Idle")
    field(ONST, "Heating")
    field(TWST, "Soaking")
    field(THST, "Done")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
}

record(longin, "$(P)Shots") {
    field(DESC, "累计采样点数")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")
    field(EGU,  "counts")
}

record(longout, "$(P)ShotsSet") {
    field(DESC, "设置采样点数")
    field(DTYP, "Soft Channel")
}

# -----------------------------------------------------------------------------
# 6) 波形：一段一维数据（探测器/示波器轨迹的最小模型）
# -----------------------------------------------------------------------------
record(waveform, "$(P)Trace") {
    field(DESC, "一维数据缓冲")
    field(DTYP, "Soft Channel")
    field(NELM, "1024")
    field(FTVL, "DOUBLE")
    field(EGU,  "counts")
}

# -----------------------------------------------------------------------------
# 7) 假的运动轴 + 假的探测器
#    Theta   = 客户端写目标角
#    ThetaRB = 回读，用 SMOO 模拟"电机要爬一会儿才到位"
#    Counts  = 探测器计数率，由 06-sim/detector_sim.py 这个"虚拟设备"更新
# -----------------------------------------------------------------------------
record(ao, "$(P)Theta") {
    field(DESC, "样品台角度设定")
    field(DTYP, "Soft Channel")
    field(EGU,  "deg")
    field(DRVL, "0")
    field(DRVH, "90")
    field(PREC, "3")
    field(IVOA, "Set output to IVOV")
    field(IVOV, "0")
}

record(ai, "$(P)ThetaRB") {
    field(DESC, "角度回读带机械滞后")
    field(DTYP, "Soft Channel")
    field(INP,  "$(P)Theta")
    field(SCAN, ".1 second")
    field(SMOO, "0.8")
    field(EGU,  "deg")
    field(PREC, "3")
    field(HOPR, "90")
    field(LOPR, "0")
}

record(ai, "$(P)Counts") {
    field(DESC, "探测器计数率")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")
    field(EGU,  "counts/s")
    field(PREC, "1")
    field(HOPR, "1000")
    field(LOPR, "0")
}

record(stringin, "$(P)SampleName") {
    field(DESC, "样品名")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")
}

record(stringout, "$(P)SampleNameSet") {
    field(DESC, "设置样品名")
    field(DTYP, "Soft Channel")
}
