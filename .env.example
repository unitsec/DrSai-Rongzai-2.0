# ------------#
# 运行通用配置 #
# ------------#
# 所有账户的智能体工作区
WORKDIR="/home/wangh/rongzai-agent/agentWorkSpace"
# 智能体skills存放目录
SYSTEM_SKILLS_DIR="/home/wangh/rongzai-agent/agent_skills"
# 前端用户文件根目录
DRSAI_UI_USER_FILES_ROOT="/home/wangh/rongzai-agent/tmp/drsai_ui/files/user"

# VNC服务配置，需要地址和端口开放
VNC_SERVICE_URL="http://**/api/vncapi"
MIN_PORT="40000"
MAX_PORT="65000"
# 是否将前端上传的文件上传到文件系统
USE_HEPAI_FILE=false
# 前端默认展示的智能体
DEFAULT_REMOTE_AGENTS="/home/wangh/rongzai-agent/remote_agents_test.json"

# ------------#
# 开发环境配置 #
# ------------#
SERVICE_MODE="DEV"

# 访问LLM和文件系统的API-KEY,通过ai.ihep.ac.cn获取
HEPAI_API_KEY=""

# 上下文超长时的“历史总结子智能体”专用模型配置名（对应 run_agent_test.py 里的 llm_mode_config key）
RONGZAI_SUMMARY_MODEL_CONFIG="deepseek-v4-flash (free)"

# 为防止大模型并发达到上限，配置的备用模型
RONGZAI_LLM_FALLBACK_CONFIGS='["openai/gpt-5","deepseek-ai/deepseek-v4-pro","minimax/minimax-m2.7"]'

RONGZAI_FORCE_INVALID_MODEL_OUTPUT="false"

BLACK_LIST=""

DRSAI_UI_MODE=internal
DRSAI_UI_INTERNAL_SRC=/home/wangh/rongzai-agent/src
DRSUI_AUTO_LOAD_DEFAULT_AGENT=true
DRSUI_DEFAULT_AGENT_NAME=RongzaiAgentTest

# 大模型采样参数。留空表示使用模型服务默认值。
RONGZAI_LLM_TEMPERATURE=1 #0-2
# DeepSeek 思考模式；关闭后 temperature 才会生效。
RONGZAI_DEEPSEEK_THINKING=true

RONGZAI_CONTEXT_COMPRESS_THRESHOLD_TOKENS=50000
# 100000

RONGZAI_DISABLE_CORE_SKILL_TOOLS=0
RONGZAI_DISABLE_MEMO_WRITE_TOOL=0